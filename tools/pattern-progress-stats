#!/bin/bash
#
# Progress and throughput for a find-optimal strip search, from its log.
#
#   tools/pattern-progress-stats logs/find-optimal-5090-oracle.log
#   tools/pattern-progress-stats --watch logs/find-optimal-5090-oracle.log
#   tools/pattern-progress-stats --watch=5 logs/...      # refresh every 5s
#
# --watch redraws in place, which is simpler than wrapping this in watch(1): the script
# keeps its terminal, so colour works without watch -c and without forcing codes into a pipe.
#
# The unit throughout is an interval: one centerIdx:middleIdx pair, which is one line in the
# log, 128 middle blocks of work, and about 4.2 trillion patterns of the space. There are
# 8548 x 512 of them.
#
# The search walks centerIdx 0..8547 in order, and middleIdx 0..511 within each, so the
# current position is itself the progress: everything behind it is either searched or was
# skipped as already complete. Percentages are of the whole space, so they count what
# earlier runs did as well - "this log" is the part this one contributed.
#
# Restarts are handled by ignoring gaps longer than STATS_GAP seconds (default 600) when
# measuring elapsed time, so downtime between runs does not depress the rate.

set -o pipefail

want_color=auto
interval=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --color)     want_color=always; shift ;;
    --no-color)  want_color=never;  shift ;;
    --watch)     interval=10; shift ;;
    --watch=*)   interval="${1#--watch=}"; shift ;;
    -w)          interval="${2:-10}"; shift 2 ;;
    --)          shift; break ;;
    -*)          echo "unknown option: $1" >&2; exit 2 ;;
    *)           break ;;
  esac
done

log=${1:-}
if [ -z "$log" ]; then
  echo "usage: $(basename "$0") [--watch[=SECONDS]] [--color|--no-color] <logfile>" >&2
  exit 2
fi
if [ ! -r "$log" ]; then
  echo "cannot read $log" >&2
  exit 1
fi
case "$interval" in
  ''|*[!0-9]*) echo "watch interval must be a whole number of seconds" >&2; exit 2 ;;
esac

# Matches include/constants.h: CENTER_4X4_TOTAL_UNIQUE and STRIP_SEARCH_TOTAL_MIDDLE_IDX
centers=${STATS_CENTERS:-8548}
middles=${STATS_MIDDLES:-512}
gap=${STATS_GAP:-600}
recent=${STATS_RECENT:-100}

# Colour follows the usual conventions: off when stdout is not a terminal, so piping or
# redirecting never emits escape codes. NO_COLOR forces it off, CLICOLOR_FORCE on. Decided
# once here, up front, because --watch renders into a capture where the test would fail.
usecolor=0
case "$want_color" in
  always) usecolor=1 ;;
  never)  usecolor=0 ;;
  *)      if [ -n "${NO_COLOR:-}" ]; then usecolor=0
          elif [ -n "${CLICOLOR_FORCE:-}" ]; then usecolor=1
          elif [ -t 1 ]; then usecolor=1
          fi ;;
esac

if [ "$usecolor" = 1 ]; then
  bold=$'\033[1m'; dim=$'\033[2m'; cyan=$'\033[36m'
  green=$'\033[32m'; yellow=$'\033[33m'; reset=$'\033[0m'
  hi=$'\033[1;93m'        # bright yellow: the few values worth finding at a glance
  found=$'\033[1;92m'     # bright green: a new record
else
  bold=""; dim=""; cyan=""; green=""; yellow=""; reset=""; hi=""; found=""
fi

render() {
  awk -v centers="$centers" -v middles="$middles" -v gap="$gap" -v recent="$recent" \
      -v bold="$bold" -v dim="$dim" -v cyan="$cyan" -v green="$green" -v yellow="$yellow" \
      -v reset="$reset" -v hi="$hi" -v found="$found" '
function commas(v,   s, out, len, i) {
  s = sprintf("%d", v); len = length(s); out = ""
  for (i = 1; i <= len; i++) {
    out = out substr(s, i, 1)
    if ((len - i) % 3 == 0 && i < len) out = out ","
  }
  return out
}

function brief(v) {
  if (v < 1000) return sprintf("%d", v)
  if (v < 1000000) return sprintf("%.0fk", v / 1000)
  return sprintf("%.1fm", v / 1000000)
}

function human(v,   units, i, a) {
  split(" ,K,M,G,T,P", units, ",")
  i = 1; a = (v < 0 ? -v : v)
  while (a >= 1000 && i < 6) { v /= 1000; a /= 1000; i++ }
  return (i == 1) ? sprintf("%.0f", v) : sprintf("%.2f %s", v, units[i])
}

function duration(sec,   d, h, m, y, mo) {
  d = int(sec / 86400); sec -= d * 86400
  h = int(sec / 3600);  sec -= h * 3600
  m = int(sec / 60)
  # 30.44 days, the mean month, so a year lands on twelve of them
  if (d >= 365) { y = int(d / 365.25); mo = int((d - y * 365.25) / 30.44); return sprintf("%dy %dmo", y, mo) }
  if (d >= 60)  { mo = int(d / 30.44); return sprintf("%dmo %dd", mo, int(d - mo * 30.44)) }
  if (d >= 10)  return sprintf("%dd", d)
  if (d > 0)    return sprintf("%dd %dh", d, h)
  if (h > 0)    return sprintf("%dh %dm", h, m)
  return sprintf("%dm", m)
}

# Cells are collected per column, then printed row by row. Padding is computed from the
# plain text because the colour codes are invisible but still count toward a string length.
function add(col, label, coloured, plain) {
  rows[col]++
  lab[col, rows[col]] = label
  val[col, rows[col]] = coloured
  txt[col, rows[col]] = (plain == "") ? coloured : plain
  if (rows[col] > maxRows) maxRows = rows[col]
}

# Ordinary value, and one worth picking out of the table at a glance
function plainCell(col, label, value)  { add(col, label, cyan value reset, value) }
function boldCell(col, label, value)   { add(col, label, hi value reset, value) }

function centred(text, width,   left) {
  left = int((width - length(text)) / 2)
  if (left < 0) left = 0
  return sprintf("%" (left + length(text)) "s%" (width - left - length(text)) "s", text, "")
}

function rule(width,   s, i) {
  s = ""
  for (i = 0; i < width; i++) s = s "-"
  return s
}

function emit(   c, r, out, plain, padding) {
  out = ""
  for (c = 1; c <= 3; c++) out = out centred(TITLE[c], W[c]) "  "
  sub(/ +$/, "", out)
  printf "%s%s%s\n", bold, out, reset

  out = ""
  for (c = 1; c <= 3; c++) out = out rule(W[c]) "  "
  sub(/ +$/, "", out)
  printf "%s%s%s\n", dim, out, reset

  for (r = 1; r <= maxRows; r++) {
    out = ""
    for (c = 1; c <= 3; c++) {
      if (r <= rows[c]) {
        plain = sprintf("%-" L[c] "s %s", lab[c, r], txt[c, r])
        padding = W[c] + 2 - length(plain)
        if (padding < 1) padding = 1
        out = out dim sprintf("%-" L[c] "s", lab[c, r]) reset " " val[c, r] \
              sprintf("%" padding "s", "")
      } else {
        out = out sprintf("%" (W[c] + 2) "s", "")
      }
    }
    sub(/ +$/, "", out)
    print out
  }
}

# First input is the log in order; second is the patternsPerSec values sorted, for the
# median and the maximum without sorting inside awk.
FNR == NR {
  if (match($0, /timestamp=[0-9]+/))  ts     = substr($0, RSTART + 10, RLENGTH - 10) + 0
  if (match($0, /centerIdx=[0-9]+/))  center = substr($0, RSTART + 10, RLENGTH - 10) + 0
  if (match($0, /middleIdx=[0-9]+/))  middle = substr($0, RSTART + 10, RLENGTH - 10) + 0
  if (match($0, /highGenerations=[0-9]+/)) high = substr($0, RSTART + 16, RLENGTH - 16) + 0

  # Only intervals that were fully searched report a best, so these are the histogram
  # samples. Zero means nothing survived long enough, which is not a sample worth showing.
  if (match($0, /bestGenerations=[0-9]+/)) {
    best = substr($0, RSTART + 16, RLENGTH - 16) + 0
    if (best > 0) {
      lastBest[++bestCount % 3] = best
      if (best > bestSeen) { bestSeen = best; bestAt = sprintf("%d:%d", center, middle) }
    }
  }

  if (match($0, /patternsPerSec=[0-9,]+/)) {
    pps = substr($0, RSTART + 15, RLENGTH - 15)
    gsub(/,/, "", pps)
    ordered[++p] = pps + 0
  }

  n++
  if (n > 1) {
    delta = ts - prev
    if (delta >= 0 && delta <= gap) active += delta
    else if (delta > gap) restarts++
  }
  prev = ts; last = ts; lastCenter = center; lastMiddle = middle

  if ($0 ~ /mode=exact/) exact++
  else if ($0 ~ /mode=oracle/) oracle++

  win[n % recent] = ts
  next
}

{ sortedPps[++k] = $1 + 0 }

END {
  if (n == 0) { print "no interval lines in the log"; exit 1 }

  total = centers * middles
  position = lastCenter * middles + lastMiddle
  remaining = total - position

  # 2^64 / (8548 * 512): what the search calls one interval of the space, and what its
  # patternsPerSec is measured against
  perInterval = 4214880325120

  TITLE[1] = "SEARCH"; W[1] = 38; L[1] = 8
  TITLE[2] = "PACE";   W[2] = 34; L[2] = 9
  TITLE[3] = "SPEED";  W[3] = 27; L[3] = 9

  pctDone = sprintf("%.2f%%", 100.0 * position / total)
  rest = sprintf(" (%s done, %s left)", brief(position), brief(remaining))
  add(1, "complete", hi pctDone reset cyan rest reset, pctDone rest)
  plainCell(1, "center", sprintf("%s of %s", commas(lastCenter), commas(centers)))
  plainCell(1, "middle", sprintf("%s of %s", commas(lastMiddle), commas(middles)))

  if (high > 0 && bestSeen > high) {
    value = sprintf("%d NEW RECORD at %s", bestSeen, bestAt)
    add(1, "best", found value reset, value)
  } else if (high > 0) {
    boldCell(1, "best", sprintf("%d", high))
  } else if (bestSeen > 0) {
    boldCell(1, "best", sprintf("%d at %s", bestSeen, bestAt))
  }

  if (bestCount > 0) {
    recents = ""
    for (i = 0; i < 3 && i < bestCount; i++) {
      recents = recents (recents == "" ? "" : ", ") lastBest[(bestCount - i) % 3]
    }
    plainCell(1, "last", recents)
  }

  plainCell(2, "this log", sprintf("%s of %s done", commas(n), brief(position)))
  plainCell(2, "elapsed", duration(active) (restarts > 0 ? sprintf(", %d restarts", restarts) : ""))

  if (active > 0 && n > 1) {
    rate = (n - 1) * 3600.0 / active          # intervals per hour
    effective = n * perInterval / active      # patterns/sec, work over time

    recentRate = 0
    if (n > recent) {
      oldest = win[(n + 1) % recent]
      if (last > oldest) recentRate = (recent - 1) * 3600.0 / (last - oldest)
    }

    plainCell(2, "rate", sprintf("%s/hr", commas(rate)))
    boldCell(2, "eta sust", duration(remaining / rate * 3600.0))
    if (recentRate > 0) {
      boldCell(2, "eta last", duration(remaining / recentRate * 3600.0))
    }
  }

  if (k > 0) {
    median = (k % 2) ? sortedPps[(k + 1) / 2] : (sortedPps[k / 2] + sortedPps[k / 2 + 1]) / 2

    # Total work over total time, which is what the eta divides by. It sits below the median
    # on purpose: a slow interval eats disproportionate time while contributing one sample,
    # so the median always reads higher and an eta derived from it comes out optimistic.
    if (active > 0) plainCell(3, "sustained", sprintf("%s/s", human(n * perInterval / active)))
    plainCell(3, "median", human(median) "/s")
    if (p > recent) {
      window = 0
      for (i = p - recent + 1; i <= p; i++) window += ordered[i]
      window /= recent
      pct = (median > 0) ? (window - median) * 100.0 / median : 0
      value = sprintf("%s/s %+.0f%%", human(window), pct)
      add(3, sprintf("last%d", recent), (pct >= 0 ? green : yellow) value reset, value)
    }
    plainCell(3, "max", human(sortedPps[k]) "/s")
  }

  emit()
}
' "$1" "$2"
}

prepare() {
  grep 'timestamp=' "$log" > "$tmplog"
  grep -o 'patternsPerSec=[0-9,]*' "$log" | sed 's/.*=//' | tr -d ',' | sort -g > "$tmppps"
}

tmplog=$(mktemp) && tmppps=$(mktemp) || exit 1
trap 'rm -f "$tmplog" "$tmppps"' EXIT

if [ "$interval" -eq 0 ]; then
  prepare
  render "$tmplog" "$tmppps"
  exit $?
fi

# Redraw in place: home the cursor and clear below it, so a shorter report cannot leave
# stale lines behind and the screen does not flash the way a full clear does.
trap 'printf "\033[?25h\n"; rm -f "$tmplog" "$tmppps"; exit 0' INT TERM
printf '\033[?25l'
while true; do
  prepare
  out=$(render "$tmplog" "$tmppps")
  printf '\033[H\033[J%severy %ss   %s   %s%s\n\n%s\n' \
    "$dim" "$interval" "$log" "$(date '+%a %d %b %H:%M:%S')" "$reset" "$out"
  sleep "$interval"
done
