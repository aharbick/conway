#!/bin/bash
#
# Progress and throughput for a find-optimal strip search, from its log.
#
#   tools/pattern-progress-stats logs/find-optimal-5090-oracle.log
#   tools/pattern-progress-stats --watch logs/find-optimal-5090-oracle.log
#   tools/pattern-progress-stats --watch=5 logs/...      # refresh every 5s
#
# --watch redraws in place, which is simpler than wrapping this in watch(1): the script
# keeps its terminal, so colour works without watch -c and without forcing codes into a pipe.
#
# Three sections: how far the search has got, how fast it is going and what that implies for
# finishing, and the spread of the patternsPerSec values - the last of which is handed to
# tools/stats so the summary is not duplicated.
#
# The search walks centerIdx 0..8547 in order, and middleIdx 0..511 within each, so the
# current position is itself the progress: everything behind it is either searched or was
# skipped as already complete. Percentages are of the whole space, not of this run.
#
# Restarts are handled by ignoring gaps longer than STATS_GAP seconds (default 600) when
# measuring elapsed time, so downtime between runs does not depress the rate.

set -o pipefail

want_color=auto
interval=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --color)     want_color=always; shift ;;
    --no-color)  want_color=never;  shift ;;
    --watch)     interval=10; shift ;;
    --watch=*)   interval="${1#--watch=}"; shift ;;
    -w)          interval="${2:-10}"; shift 2 ;;
    --)          shift; break ;;
    -*)          echo "unknown option: $1" >&2; exit 2 ;;
    *)           break ;;
  esac
done

log=${1:-}
if [ -z "$log" ]; then
  echo "usage: $(basename "$0") [--watch[=SECONDS]] [--color|--no-color] <logfile>" >&2
  exit 2
fi
if [ ! -r "$log" ]; then
  echo "cannot read $log" >&2
  exit 1
fi
case "$interval" in
  ''|*[!0-9]*) echo "watch interval must be a whole number of seconds" >&2; exit 2 ;;
esac

# Matches include/constants.h: CENTER_4X4_TOTAL_UNIQUE and STRIP_SEARCH_TOTAL_MIDDLE_IDX
centers=${STATS_CENTERS:-8548}
middles=${STATS_MIDDLES:-512}
gap=${STATS_GAP:-600}
recent=${STATS_RECENT:-100}

# Colour follows the usual conventions: off when stdout is not a terminal, so piping or
# redirecting never emits escape codes. NO_COLOR forces it off, CLICOLOR_FORCE on. Decided
# once here, up front, because --watch renders into a capture where the test would fail.
usecolor=0
case "$want_color" in
  always) usecolor=1 ;;
  never)  usecolor=0 ;;
  *)      if [ -n "${NO_COLOR:-}" ]; then usecolor=0
          elif [ -n "${CLICOLOR_FORCE:-}" ]; then usecolor=1
          elif [ -t 1 ]; then usecolor=1
          fi ;;
esac

if [ "$usecolor" = 1 ]; then
  bold=$'\033[1m'; dim=$'\033[2m'; cyan=$'\033[36m'
  green=$'\033[32m'; yellow=$'\033[33m'; reset=$'\033[0m'
  stats_color=always
else
  bold=""; dim=""; cyan=""; green=""; yellow=""; reset=""
  stats_color=never
fi

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

render() {
grep 'timestamp=' "$log" | awk \
  -v centers="$centers" -v middles="$middles" -v gap="$gap" -v recent="$recent" \
  -v bold="$bold" -v dim="$dim" -v cyan="$cyan" -v green="$green" -v yellow="$yellow" \
  -v reset="$reset" '
function commas(v,   s, out, len, i) {
  s = sprintf("%d", v); len = length(s); out = ""
  for (i = 1; i <= len; i++) {
    out = out substr(s, i, 1)
    if ((len - i) % 3 == 0 && i < len) out = out ","
  }
  return out
}

function duration(sec,   d, h, m) {
  d = int(sec / 86400); sec -= d * 86400
  h = int(sec / 3600);  sec -= h * 3600
  m = int(sec / 60)
  if (d > 0) return sprintf("%dd %dh", d, h)
  if (h > 0) return sprintf("%dh %dm", h, m)
  return sprintf("%dm", m)
}

function row(label, value, note) {
  if (note == "") printf "  %-11s %s%s%s\n", label, cyan, value, reset
  else            printf "  %-11s %s%-26s%s %s%s%s\n", label, cyan, value, reset, dim, note, reset
}

{
  # Tolerates both log formats: intervals that found nothing omit the best* fields
  if (match($0, /timestamp=[0-9]+/))  ts     = substr($0, RSTART + 10, RLENGTH - 10) + 0
  if (match($0, /centerIdx=[0-9]+/))  center = substr($0, RSTART + 10, RLENGTH - 10) + 0
  if (match($0, /middleIdx=[0-9]+/))  middle = substr($0, RSTART + 10, RLENGTH - 10) + 0

  # The bar this interval was searched against, and what it actually found
  if (match($0, /highGenerations=[0-9]+/)) high = substr($0, RSTART + 16, RLENGTH - 16) + 0
  if (match($0, /bestGenerations=[0-9]+/)) {
    best = substr($0, RSTART + 16, RLENGTH - 16) + 0
    if (best > bestSeen) { bestSeen = best; bestAt = sprintf("%d:%d", center, middle) }
  }

  n++
  if (n > 1) {
    delta = ts - prev
    if (delta >= 0 && delta <= gap) active += delta
    else if (delta > gap) restarts++
  }
  prev = ts; last = ts; lastCenter = center; lastMiddle = middle

  if ($0 ~ /mode=exact/) exact++
  else if ($0 ~ /mode=oracle/) oracle++

  # Recent window of timestamps, for a rate that reflects now rather than the lifetime
  win[n % recent] = ts
}

END {
  if (n == 0) { print "no interval lines in the log"; exit 1 }

  total = centers * middles
  position = lastCenter * middles + lastMiddle
  remaining = total - position

  printf "%ssearch%s\n", bold, reset
  row("complete", sprintf("%.2f%%", 100.0 * position / total),
      sprintf("%s of %s intervals, %s remaining", commas(position), commas(total), commas(remaining)))
  row("position", sprintf("%d:%d", lastCenter, lastMiddle),
      sprintf("center %s of %s", commas(lastCenter), commas(centers)))

  # The record is the bar an oracle run is beating, which is the best known result - not the
  # best this log happened to observe. Only the sampled exact intervals report a best at all,
  # 51 of 3,302 in a typical oracle run, so their maximum says nothing about the search and
  # belongs with the other sample statistics rather than here.
  if (high > 0) {
    if (bestSeen > high) {
      printf "  %-11s %s%s%d generations%s %s*** NEW RECORD at %s, previous bar %d ***%s\n",
             "record", bold, green, bestSeen, reset, green, bestAt, high, reset
    } else {
      row("record", sprintf("%d generations", high), "the bar; nothing above it found yet")
    }
  } else if (bestSeen > 0) {
    # An exhaustive log has no bar, and there every interval reports its best, so the
    # maximum really is the best found
    row("record", sprintf("%d generations", bestSeen), sprintf("best found, at %s", bestAt))
  }

  printf "\n%space%s\n", bold, reset
  modeNote = "no mode recorded, so an exhaustive run"
  if (exact + oracle > 0) modeNote = sprintf("%s exact, %s oracle", commas(exact), commas(oracle))
  row("intervals", commas(n), modeNote)
  if (high > 0 && bestSeen > 0 && bestSeen <= high) {
    row("best sample", sprintf("%d generations", bestSeen),
        sprintf("at %s, highest of the %s exact intervals", bestAt, commas(exact)))
  }
  row("elapsed", duration(active),
      (restarts > 0 ? sprintf("%d restart(s) excluded", restarts) : "running time"))

  if (active > 0 && n > 1) {
    rate = (n - 1) * 3600.0 / active                 # intervals per hour

    # Interval cost swings by more than 5x with center density, so the lifetime rate and the
    # last hundred can differ by half. Both are shown rather than picking one.
    recentRate = 0
    if (n > recent) {
      oldest = win[(n + 1) % recent]
      if (last > oldest) recentRate = (recent - 1) * 3600.0 / (last - oldest)
    }

    if (recentRate > 0) {
      pct = (recentRate - rate) * 100.0 / rate
      row("rate", sprintf("%s intervals/hour", commas(rate)),
          sprintf("last %d: %s (%s%+.0f%%%s)", recent, commas(recentRate),
                  (pct >= 0 ? green : yellow), pct, dim))
      row("eta", duration(remaining / rate * 3600.0),
          sprintf("%s at the recent rate", duration(remaining / recentRate * 3600.0)))
    } else {
      row("rate", sprintf("%s intervals/hour", commas(rate)), "")
      row("eta", duration(remaining / rate * 3600.0), "")
    }
  }
}
'
  printf "\n%spatterns/sec%s\n" "$bold" "$reset"
  grep -o 'patternsPerSec=[0-9,]*' "$log" | sed 's/.*=//' |
    STATS_RECENT="$recent" stats_color="$stats_color" "$here/stats" | sed 's/^/  /'
}

if [ "$interval" -eq 0 ]; then
  render
  exit $?
fi

# Redraw in place: home the cursor and clear below it, so a shorter report cannot leave
# stale lines behind and the screen does not flash the way a full clear does.
trap 'printf "\033[?25h\n"; exit 0' INT TERM
printf '\033[?25l'
while true; do
  out=$(render)
  printf '\033[H\033[J%severy %ss   %s   %s%s\n\n%s\n' \
    "$dim" "$interval" "$log" "$(date '+%a %d %b %H:%M:%S')" "$reset" "$out"
  sleep "$interval"
done
