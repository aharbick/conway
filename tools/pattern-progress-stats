#!/bin/bash
#
# Progress and throughput for a find-optimal strip search, from its log.
#
#   tools/pattern-progress-stats logs/find-optimal-5090-oracle.log
#   tools/pattern-progress-stats --watch logs/find-optimal-5090-oracle.log
#   tools/pattern-progress-stats --watch=5 logs/...      # refresh every 5s
#   tools/pattern-progress-stats --rescan logs/...       # rebuild the counters from scratch
#
# --watch redraws in place, which is simpler than wrapping this in watch(1): the script
# keeps its terminal, so colour works without watch -c and without forcing codes into a pipe.
#
# The unit throughout is an interval: one centerIdx:middleIdx pair, which is one line in the
# log, 128 middle blocks of work, and about 4.2 trillion patterns of the space. There are
# 8548 x 512 of them.
#
# The search walks centerIdx 0..8547 in order, and middleIdx 0..511 within each, so the
# current position is itself the progress: everything behind it is either searched or was
# skipped as already settled. Percentages are of the whole space, so they count what
# earlier runs did as well - "this log" is the part this one contributed.
#
# "searched", not "complete": behind the head an interval was settled one of two ways, and
# only one of them is exhaustive coverage. A full run records the interval in the shared
# completion bitmap; an oracle run only establishes that nothing there reaches its target,
# and records that in its own file. The head passes both, so this figure is their union and
# runs ahead of the exhaustive count - 441,534 against 436,766 when this was written. The
# bitmaps themselves are the authority on which is which; this reads only the log.
#
# Restarts are handled by ignoring gaps longer than STATS_GAP seconds (default 600) when
# measuring elapsed time, so downtime between runs does not depress the rate.
#
# A finished search leaves 4.4m lines behind, and re-reading that every few seconds would
# take longer than the refresh interval. So the whole-run counters - the interval count, the
# elapsed time, the restarts, the best seen - live in a small cache under
# $XDG_CACHE_HOME/pattern-progress-stats, advanced by only the bytes appended since the last
# render, and everything else is computed from the tail of the log. The cache rebuilds
# itself if the log is rotated or truncated, and --rescan forces it.
#
#   STATS_WINDOW_MB=20   how much of the tail the median, max and last100 see (default 20)
#   STATS_PLOT_N=2000    intervals the plot covers (default: 20 per column, so about 1800)
#
# Mail. --notify evaluates three triggers and sends what fired: the next whole percent, a
# new best, and a daily summary. The mailed report covers the last 24 hours rather than the
# last hundred intervals, since the screen already shows the recent window.
#
#   tools/pattern-progress-stats --watch --notify --mailto me@example.com logs/...
#   tools/pattern-progress-stats --notify --mailto me@example.com logs/...   # for cron
#   tools/pattern-progress-stats --mail-now --mailto me@example.com logs/... # test one now
#
# With --watch the triggers are evaluated on every tick, which costs three comparisons
# unless one fires, and what it did shows in the header rather than being printed over the
# report. Both forms share their state under a lock, so a watch session and a cron entry
# running together cannot both decide the same trigger fired and mail it twice.
#
# A first --notify records where things stand and stays quiet, so it does not announce a
# percentage and a record that were both reached weeks ago. It does not send that day's
# summary either, unless the hour has yet to come round. What has been announced lives in
# a .notify file beside the counter cache, and a trigger is only recorded once its mail is
# away - a failed send stays pending and retries.
#
# Sending is a pipe to sendmail, so any MTA works and the tool holds no credentials. On this
# box that is msmtp relaying through Gmail on port 587 (~/.config/msmtp/config).
#
# It has to be SMTP submission rather than an API. Mail sent by Apps Script's MailApp never
# reached the sending account's own inbox - accepted, quota decremented, delivered according
# to its own headers, and filed under Sent with no inbox copy - while the same account
# submitting the same message over SMTP lands normally.
#
#   --mailto ADDR                  where to send; required by --notify and --mail-now
#   STATS_SENDMAIL=/path/to/mta    the binary to pipe to (default: sendmail)
#   STATS_MAIL_FROM='n <a@b.c>'    a From header; omitted, the MTA supplies one
#
# Every ten minutes from cron is plenty - the triggers are level-based, not edge-based, so
# nothing is missed by checking infrequently:
#
#   */10 * * * * cd ~/Projects/conway && tools/pattern-progress-stats --notify \
#                  --mailto you@example.com \
#                  find-optimal/logs/find-optimal-5090-oracle.log
#
#   STATS_DAILY_HOUR=9          local hour the daily summary goes out (default 9am)
#   STATS_MAIL_ROWS=40          rows to size the mailed plot to, having no terminal

set -o pipefail

want_color=auto
interval=0
nograph=
rescan=
notify=
mailnow=
mailto=
while [ "$#" -gt 0 ]; do
  case "$1" in
    --color)     want_color=always; shift ;;
    --no-graph)  nograph=1; shift ;;
    --rescan)    rescan=1; shift ;;
    --notify)    notify=1; shift ;;
    --mail-now)  notify=1; mailnow=1; shift ;;
    --mailto)    mailto="${2:-}"; shift 2 ;;
    --mailto=*)  mailto="${1#--mailto=}"; shift ;;
    --no-color)  want_color=never;  shift ;;
    --watch)     interval=10; shift ;;
    --watch=*)   interval="${1#--watch=}"; shift ;;
    -w)          interval="${2:-10}"; shift 2 ;;
    --)          shift; break ;;
    -*)          echo "unknown option: $1" >&2; exit 2 ;;
    *)           break ;;
  esac
done

log=${1:-}
if [ -z "$log" ]; then
  echo "usage: $(basename "$0") [--watch[=SECONDS]] [--no-graph] [--rescan]" \
       "[--notify|--mail-now] [--mailto ADDR] [--color|--no-color] <logfile>" >&2
  exit 2
fi
if [ ! -r "$log" ]; then
  echo "cannot read $log" >&2
  exit 1
fi
case "$interval" in
  ''|*[!0-9]*) echo "watch interval must be a whole number of seconds" >&2; exit 2 ;;
esac

# Matches include/constants.h: CENTER_4X4_TOTAL_UNIQUE and STRIP_SEARCH_TOTAL_MIDDLE_IDX
centers=${STATS_CENTERS:-8548}
middles=${STATS_MIDDLES:-512}
gap=${STATS_GAP:-600}
recent=${STATS_RECENT:-100}
window=$(( ${STATS_WINDOW_MB:-20} * 1000000 ))
# Intervals the plot covers. The median, max and last100 read the whole tail window, but the
# plot cannot: bucketing a growing number of samples into a fixed number of columns just
# squeezes more history into each one, and the x-axis stretches from hours to weeks. 0 means
# pick it from the plot width, so a column stays a fixed number of intervals wide.
plotn=${STATS_PLOT_N:-0}

# Colour follows the usual conventions: off when stdout is not a terminal, so piping or
# redirecting never emits escape codes. NO_COLOR forces it off, CLICOLOR_FORCE on. Decided
# once here, up front, because --watch renders into a capture where the test would fail.
usecolor=0
case "$want_color" in
  always) usecolor=1 ;;
  never)  usecolor=0 ;;
  *)      if [ -n "${NO_COLOR:-}" ]; then usecolor=0
          elif [ -n "${CLICOLOR_FORCE:-}" ]; then usecolor=1
          elif [ -t 1 ]; then usecolor=1
          fi ;;
esac

if [ "$usecolor" = 1 ]; then
  bold=$'\033[1m'; dim=$'\033[2m'; cyan=$'\033[36m'
  green=$'\033[32m'; yellow=$'\033[33m'; reset=$'\033[0m'
  hi=$'\033[1;93m'        # bright yellow: the few values worth finding at a glance
  found=$'\033[1;92m'     # bright green: a new record
else
  bold=""; dim=""; cyan=""; green=""; yellow=""; reset=""; hi=""; found=""
fi

# Height the plot to the terminal, taking half of what is left below the tables: the shape
# of the two series reads fine at that height, and leaving the rest free means --watch does
# not own the whole window. The width is not set here: the plot matches the tables above it.
plot_height() {
  local size=""
  if [ -n "${forceRows:-}" ]; then
    termRows=$forceRows
  else
    [ -r /dev/tty ] && size=$(stty size 2>/dev/null </dev/tty)
    case "$size" in
      [0-9]*\ [0-9]*) termRows=${size%% *} ;;
      *)              termRows=${LINES:-32} ;;
    esac
  fi
  [ "$termRows" -gt 0 ] 2>/dev/null || termRows=32

  plotH=$(( (termRows - 14) / 2 ))
  [ "$plotH" -gt 28 ] && plotH=28
  [ "$plotH" -lt 6 ]  && plotH=6
  return 0
}

# When set, the report describes a stretch of wall clock rather than the last N intervals:
# the recent rows and the plot both follow it. Mailed reports use it; the screen does not.
periodSec=0
periodName=""

render() {
  plot_height
  awk -v centers="$centers" -v middles="$middles" -v gap="$gap" -v recent="$recent" \
      -v bold="$bold" -v dim="$dim" -v cyan="$cyan" -v green="$green" -v yellow="$yellow" \
      -v reset="$reset" -v hi_="$hi" -v found="$found" -v nograph="$nograph" \
      -v plotH="$plotH" -v plotN="$plotn" -v windowed="$windowed" \
      -v periodSec="$periodSec" -v periodName="$periodName" \
      -v totalN="$stN" -v totalActive="$stActive" -v totalRestarts="$stRestarts" \
      -v totalBest="$stBest" -v totalBestAt="$stBestAt" '
function commas(v,   s, out, len, i) {
  s = sprintf("%d", v); len = length(s); out = ""
  for (i = 1; i <= len; i++) {
    out = out substr(s, i, 1)
    if ((len - i) % 3 == 0 && i < len) out = out ","
  }
  return out
}

function brief(v) {
  if (v < 1000) return sprintf("%d", v)
  if (v < 1000000) return sprintf("%.0fk", v / 1000)
  return sprintf("%.1fm", v / 1000000)
}

function human(v,   units, i, a) {
  split(" ,K,M,G,T,P", units, ",")
  i = 1; a = (v < 0 ? -v : v)
  while (a >= 1000 && i < 6) { v /= 1000; a /= 1000; i++ }
  return (i == 1) ? sprintf("%.0f", v) : sprintf("%.2f %s", v, units[i])
}

function duration(sec,   d, h, m, y, mo) {
  d = int(sec / 86400); sec -= d * 86400
  h = int(sec / 3600);  sec -= h * 3600
  m = int(sec / 60)
  # 30.44 days, the mean month, so a year lands on twelve of them
  if (d >= 365) { y = int(d / 365.25); mo = int((d - y * 365.25) / 30.44); return sprintf("%dy %dmo", y, mo) }
  if (d >= 60)  { mo = int(d / 30.44); return sprintf("%dmo %dd", mo, int(d - mo * 30.44)) }
  if (d >= 10)  return sprintf("%dd", d)
  if (d > 0)    return sprintf("%dd %dh", d, h)
  if (h > 0)    return sprintf("%dh %dm", h, m)
  return sprintf("%dm", m)
}

# Cells are collected per column, then printed row by row. Padding is computed from the
# plain text because the colour codes are invisible but still count toward a string length.
function add(col, label, coloured, plain) {
  rows[col]++
  lab[col, rows[col]] = label
  val[col, rows[col]] = coloured
  txt[col, rows[col]] = (plain == "") ? coloured : plain
  if (rows[col] > maxRows) maxRows = rows[col]
}

# Ordinary value, and one worth picking out of the table at a glance
function plainCell(col, label, value)  { add(col, label, cyan value reset, value) }
function boldCell(col, label, value)   { add(col, label, hi_ value reset, value) }

function centred(text, width,   left) {
  left = int((width - length(text)) / 2)
  if (left < 0) left = 0
  return sprintf("%" (left + length(text)) "s%" (width - left - length(text)) "s", text, "")
}

function rule(width,   s, i) {
  s = ""
  for (i = 0; i < width; i++) s = s "-"
  return s
}

# Two series over time: the raw per-interval rate, and its trailing average. A column is
# many intervals wide, so the raw series takes one of them rather than their spread: center
# density swings throughput by more than 5x from one interval to the next, and a min-to-max
# band at this width fills the plot solid. The average is the line the eta actually follows.
function scale(v, lo, hi, height,   r) {
  r = int((v - lo) / (hi - lo) * (height - 1))
  return (r < 0) ? 0 : ((r > height - 1) ? height - 1 : r)
}

function graph(tableW, height,   i, x, lo, hi, sum, ma, from, to, val, width,
                                 row, col, grid, out, label, span, first, shown, maWin) {
  if (p < 4) return

  # The plot lines up with the tables above it: same right edge, with the y-axis labels and
  # the spine taking the first GUTTER columns.
  width = tableW - GUTTER
  if (width < 20) return

  # A trailing harmonic mean, which is exactly the work done over the time it took. The
  # arithmetic mean would trace a line well above the throughput actually achieved: a slow
  # interval occupies far more wall clock than a fast one but contributes the same single
  # sample, so averaging the rates over-weights the fast ones.

  # Only the tail of the series is drawn. A column holds a fixed number of intervals, so the
  # x-axis spans a roughly fixed stretch of time no matter how long the log gets, instead of
  # compressing an ever-growing history into the same width. The trailing mean above is still
  # computed over everything, so the leftmost column arrives with its lead-in already done.
  if (periodSec > 0) {
    first = rFirst
  } else {
    shown = (plotN > 0) ? plotN : width * PLOT_PER_COLUMN
    first = p - shown + 1
  }
  if (first < 1) first = 1
  shown = p - first + 1

  # Smooth over about five columns rather than a fixed hundred samples: a day-long plot has
  # a hundred intervals inside a single column, and a trailing mean that short traces the
  # noise instead of the trend.
  maWin = int(shown / width) * 5
  if (maWin < recent) maWin = recent

  sum = 0
  for (i = 1; i <= p; i++) {
    if (ordered[i] > 0) sum += 1.0 / ordered[i]
    if (i > maWin && ordered[i - maWin] > 0) sum -= 1.0 / ordered[i - maWin]
    ma[i] = (sum > 0) ? ((i < maWin) ? i : maWin) / sum : 0
  }

  # The y-range stays that of the whole tail window, not of the stretch being drawn: it
  # holds still between renders instead of rescaling as the plot slides, and the two are
  # close in practice - 385..3633 G/s against 512..3874 for the last 1,800 when measured.
  lo = sortedPps[int(k * 0.02) + 1]
  hi = sortedPps[int(k * 0.98)]
  if (hi <= lo) { lo = sortedPps[1]; hi = sortedPps[k] }
  if (hi <= lo) return

  for (x = 0; x < width; x++) {
    from = first + int(x * shown / width)
    to = first + int((x + 1) * shown / width) - 1
    if (to < from) to = from
    if (to > p) to = p
    grid[scale(ordered[to], lo, hi, height), x] = "."
    grid[scale(ma[to], lo, hi, height), x] = "*"
  }

  printf "\n"
  for (row = height - 1; row >= 0; row--) {
    out = ""
    for (col = 0; col < width; col++) {
      val = grid[row, col]
      if (val == "*") out = out hi_ "*" reset
      else if (val != "") out = out cyan "." reset
      else out = out " "
    }
    # Label the extremes and the middle; the rest of the axis stays quiet
    label = ""
    if (row == height - 1) label = human(hi) "/s"
    else if (row == 0) label = human(lo) "/s"
    else if (row == int((height - 1) / 2)) label = human((lo + hi) / 2) "/s"
    sub(/ +$/, "", out)
    printf "%s%10s %s%s%s\n", dim, label, (label == "" ? "|" : "+"), reset, (out == "" ? "" : " " out)
  }

  printf "%s%10s +%s%s\n", dim, "", rule(width + 1), reset

  span = duration(tsOf[p] - tsOf[first])
  printf "%s%10s   %s ago%*s%s\n", dim, "", span, width - length(span) - 4, "now", reset
  printf "%s%10s   %s.%s%s one interval   %s*%s%s the last %d, work over time%s\n",
         dim, "", cyan, reset, dim, hi_, reset, dim, maWin, reset
}

function emit(   c, r, out, plain, padding) {
  out = ""
  for (c = 1; c <= 3; c++) out = out centred(TITLE[c], W[c]) "  "
  sub(/ +$/, "", out)
  printf "%s%s%s\n", bold, out, reset

  out = ""
  for (c = 1; c <= 3; c++) out = out rule(W[c]) "  "
  sub(/ +$/, "", out)
  printf "%s%s%s\n", dim, out, reset

  for (r = 1; r <= maxRows; r++) {
    out = ""
    for (c = 1; c <= 3; c++) {
      if (r <= rows[c]) {
        plain = sprintf("%-" L[c] "s %s", lab[c, r], txt[c, r])
        padding = W[c] + 2 - length(plain)
        if (padding < 1) padding = 1
        out = out dim sprintf("%-" L[c] "s", lab[c, r]) reset " " val[c, r] \
              sprintf("%" padding "s", "")
      } else {
        out = out sprintf("%" (W[c] + 2) "s", "")
      }
    }
    sub(/ +$/, "", out)
    print out
  }
}

# First input is the tail window of the log in order; second is its patternsPerSec values
# sorted, for the median and the maximum without sorting inside awk. Everything derived here
# describes the window. The whole-run counters arrive as totalN/totalActive/totalRestarts,
# accumulated once per line by the state cache, so nothing here has to see the whole log.
function field(line, name, width,   v) {
  if (!match(line, name "=[0-9,]+")) return 0
  v = substr(line, RSTART + width + 1, RLENGTH - width - 1)
  gsub(/,/, "", v)
  return v + 0
}

FNR == NR {
  # Only what every line contributes is parsed per line: the position and the target come
  # from the last line alone, and pulling them out here instead would cost three more
  # regexes across the whole window for one line worth of answer.
  # These stay literal: a regex built from a variable is recompiled on every line, which
  # costs more than the three matches it would save.
  if (match($0, /timestamp=[0-9]+/)) ts = substr($0, RSTART + 10, RLENGTH - 10) + 0

  # Only intervals that were fully searched report a best, so these are the histogram
  # samples. Zero means nothing survived long enough, which is not a sample worth showing.
  if (match($0, /bestGenerations=[0-9]+/)) {
    best = substr($0, RSTART + 16, RLENGTH - 16) + 0
    if (best > 0) lastBest[++bestCount % 3] = best
  }

  if (match($0, /patternsPerSec=[0-9,]+/)) {
    pps = substr($0, RSTART + 15, RLENGTH - 15)
    gsub(/,/, "", pps)
    ordered[++p] = pps + 0
    tsOf[p] = ts
  }

  wn++
  last = ts
  lastLine = $0
  next
}

{ sortedPps[++k] = $1 + 0 }

END {
  if (wn == 0) { print "no interval lines in the log"; exit 1 }

  lastCenter = field(lastLine, "centerIdx", 9)
  lastMiddle = field(lastLine, "middleIdx", 9)
  high       = field(lastLine, "highGenerations", 15)

  # The recent window is either a count of intervals or a stretch of wall clock. A mailed
  # report wants the latter - a day of history rather than whatever the last hundred
  # intervals happened to cover - and the plot below follows the same window.
  if (periodSec > 0) {
    rFirst = p
    while (rFirst > 1 && tsOf[p] - tsOf[rFirst - 1] <= periodSec) rFirst--
    recentLabel = "last " periodName
  } else {
    rFirst = (p > recent ? p - recent + 1 : 1)
    recentLabel = "last" recent
  }
  recentCount = p - rFirst + 1

  # Throughput over that window, as work over the time it took. Both the recent eta and the
  # recent speed come from this one number, so they cannot disagree the way an averaged rate
  # and a wall-clock rate did. Deriving it from the samples rather than from a timestamp
  # difference also keeps downtime inside the window out of it.
  recentThroughput = 0
  inv = 0; counted = 0
  for (i = rFirst; i <= p; i++) {
    if (ordered[i] > 0) { inv += 1.0 / ordered[i]; counted++ }
  }
  if (inv > 0) recentThroughput = counted / inv

  total = centers * middles
  position = lastCenter * middles + lastMiddle
  remaining = total - position

  # 2^64 / (8548 * 512): what the search calls one interval of the space, and what its
  # patternsPerSec is measured against
  perInterval = 4214880325120

  # Column widths, and the y-axis gutter the plot below them reserves: a 10-column label,
  # a space, the spine, a space.
  GUTTER = 13
  # Intervals per plot column when STATS_PLOT_N does not say otherwise. Twenty keeps the
  # x-axis at a few hours at the rates this search runs at, which is the scale a slowdown
  # shows up on, and leaves the trailing mean smoothed over about five columns.
  PLOT_PER_COLUMN = 20
  TITLE[1] = "SEARCH"; W[1] = 38; L[1] = 8
  TITLE[2] = "PACE";   W[2] = 34; L[2] = 9
  TITLE[3] = "SPEED";  W[3] = 27; L[3] = 9

  pctDone = sprintf("%.2f%%", 100.0 * position / total)
  rest = sprintf(" (%s done, %s left)", brief(position), brief(remaining))
  add(1, "searched", hi_ pctDone reset cyan rest reset, pctDone rest)
  plainCell(1, "center", sprintf("%s of %s", commas(lastCenter), commas(centers)))
  plainCell(1, "middle", sprintf("%s of %s", commas(lastMiddle), commas(middles)))

  if (high > 0 && totalBest > high) {
    value = sprintf("%d NEW RECORD at %s", totalBest, totalBestAt)
    add(1, "best", found value reset, value)
  } else if (high > 0) {
    boldCell(1, "best", sprintf("%d", high))
  } else if (totalBest > 0) {
    boldCell(1, "best", sprintf("%d at %s", totalBest, totalBestAt))
  }

  if (bestCount > 0) {
    recents = ""
    for (i = 0; i < 3 && i < bestCount; i++) {
      recents = recents (recents == "" ? "" : ", ") lastBest[(bestCount - i) % 3]
    }
    plainCell(1, "last", recents)
  }

  plainCell(2, "this log", sprintf("%s of %s done", commas(totalN), brief(position)))
  plainCell(2, "elapsed",
            duration(totalActive) (totalRestarts > 0 ? sprintf(", %d restarts", totalRestarts) : ""))

  if (totalActive > 0 && totalN > 1) {
    rate = (totalN - 1) * 3600.0 / totalActive   # intervals per hour

    recentRate = (recentThroughput > 0) ? recentThroughput * 3600.0 / perInterval : 0

    plainCell(2, "rate", sprintf("%s/hr", commas(rate)))
    if (periodSec > 0) {
      plainCell(2, recentLabel, sprintf("%s intervals", commas(recentCount)))
    }
    boldCell(2, "eta sust", duration(remaining / rate * 3600.0))
    if (recentRate > 0) {
      boldCell(2, "eta " (periodSec > 0 ? periodName : "last"),
               duration(remaining / recentRate * 3600.0))
    }
  }

  if (k > 0) {
    median = (k % 2) ? sortedPps[(k + 1) / 2] : (sortedPps[k / 2] + sortedPps[k / 2 + 1]) / 2

    # Total work over total time, which is what the eta divides by. It sits below the median
    # on purpose: a slow interval eats disproportionate time while contributing one sample,
    # so the median always reads higher and an eta derived from it comes out optimistic.
    if (totalActive > 0) {
      plainCell(3, "sustained", sprintf("%s/s", human(totalN * perInterval / totalActive)))
    }
    plainCell(3, "median", human(median) "/s")
    # Measured the same way as sustained above it, and compared against it: the sign then
    # agrees with whether eta last beats eta sust, which an averaged rate did not.
    if (recentCount > 1 && recentThroughput > 0 && totalActive > 0) {
      lifetime = totalN * perInterval / totalActive
      pct = (lifetime > 0) ? (recentThroughput - lifetime) * 100.0 / lifetime : 0
      value = sprintf("%s/s %+.0f%%", human(recentThroughput), pct)
      add(3, recentLabel, (pct >= 0 ? green : yellow) value reset, value)
    }
    plainCell(3, "max", human(sortedPps[k]) "/s")
  }

  emit()

  # The cumulative figures are exact however big the log gets, but median, last100, max and
  # the graph only see the tail window, so say so rather than let them look whole-run.
  if (windowed && wn < totalN) {
    printf "%smedian and max cover the last %s intervals;" \
           " the rest is the whole log%s\n", dim, commas(wn), reset
  }

  if (!nograph) graph(W[1] + W[2] + W[3] + 4, plotH + 0)
}
' "$1" "$2"
}

# Whole-run counters, carried across renders so a growing log costs a constant amount per
# tick. Without this the script re-reads the whole file every time: 42ms at 4k lines, but
# 6.8s at a million and ~26s at the 4.4m lines a finished search would leave behind, which
# is longer than the watch interval. The cache is advanced by the bytes appended since the
# last render, so a tick reads the handful of lines that are actually new.
#
# It holds only what cannot be recovered from the tail of the log: the interval count, the
# active seconds, the restart count, the last timestamp (to continue the gap arithmetic
# across the chunk boundary) and the best generations seen. Everything else - the median,
# the maximum, the plot - is recomputed from the window each time.
statefile=""
stN=0; stActive=0; stRestarts=0; stPrev=0; stBest=0; stBestAt="-"; stOffset=0

state_path() {
  local dir="${XDG_CACHE_HOME:-$HOME/.cache}/pattern-progress-stats"
  mkdir -p "$dir" 2>/dev/null || return 1
  # One state file per log, named after its absolute path with the separators flattened
  local key
  key=$(cd "$(dirname "$log")" 2>/dev/null && printf '%s/%s' "$PWD" "$(basename "$log")")
  printf '%s/%s.state' "$dir" "$(printf '%s' "${key#/}" | tr '/ ' '__')"
}

# A log that shrank or changed identity is a different log: start over rather than carry
# counters that no longer describe it.
load_state() {
  local inode size
  inode=$(stat -c %i "$log" 2>/dev/null) || return
  size=$(stat -c %s "$log" 2>/dev/null) || return
  [ -r "$statefile" ] || return
  # shellcheck disable=SC1090
  . "$statefile" 2>/dev/null || return
  if [ "${stVersion:-0}" != 1 ] || [ "${stInode:-0}" != "$inode" ] || \
     [ "${stOffset:-0}" -gt "$size" ]; then
    stN=0; stActive=0; stRestarts=0; stPrev=0; stBest=0; stBestAt="-"; stOffset=0
  fi
}

save_state() {
  local tmp="$statefile.$$"
  {
    printf 'stVersion=1\nstInode=%s\nstOffset=%s\n' "$1" "$2"
    printf 'stN=%s\nstActive=%s\nstRestarts=%s\nstPrev=%s\n' \
           "$stN" "$stActive" "$stRestarts" "$stPrev"
    printf 'stBest=%s\nstBestAt=%s\n' "$stBest" "$stBestAt"
  } > "$tmp" && mv -f "$tmp" "$statefile"
}

# Fold the bytes appended since the last render into the counters.
advance_state() {
  local inode size chunk bytes partial
  inode=$(stat -c %i "$log" 2>/dev/null) || return
  size=$(stat -c %s "$log" 2>/dev/null) || return
  [ "$size" -le "$stOffset" ] && return

  chunk="$tmpchunk"
  tail -c "+$((stOffset + 1))" "$log" > "$chunk" || return
  bytes=$(wc -c < "$chunk")

  # The search may be mid-line: leave the partial line for the next render rather than
  # counting half an interval and then counting its other half again.
  if [ -n "$(tail -c 1 "$chunk")" ]; then
    partial=$(awk 'END { print length($0) }' "$chunk")
    bytes=$((bytes - partial))
    [ "$bytes" -le 0 ] && return
    head -c "$bytes" "$chunk" > "$chunk.t" && mv -f "$chunk.t" "$chunk"
  fi

  read -r stN stActive stRestarts stPrev stBest stBestAt <<EOF
$(awk -v n="$stN" -v active="$stActive" -v restarts="$stRestarts" -v prev="$stPrev" \
      -v best="$stBest" -v bestAt="$stBestAt" -v gap="$gap" '
/timestamp=/ {
  if (!match($0, /timestamp=[0-9]+/)) next
  ts = substr($0, RSTART + 10, RLENGTH - 10) + 0

  # Gaps longer than STATS_GAP are downtime between runs, not time spent searching
  if (n > 0) {
    d = ts - prev
    if (d >= 0 && d <= gap) active += d
    else if (d > gap) restarts++
  }
  prev = ts
  n++

  if (match($0, /bestGenerations=[0-9]+/)) {
    b = substr($0, RSTART + 16, RLENGTH - 16) + 0
    if (b > best) {
      best = b
      c = m = 0
      if (match($0, /centerIdx=[0-9]+/)) c = substr($0, RSTART + 10, RLENGTH - 10) + 0
      if (match($0, /middleIdx=[0-9]+/)) m = substr($0, RSTART + 10, RLENGTH - 10) + 0
      bestAt = c ":" m
    }
  }
}
END { print n, active, restarts, prev, best, (bestAt == "" ? "-" : bestAt) }' "$chunk")
EOF

  save_state "$inode" "$((stOffset + bytes))"
  stOffset=$((stOffset + bytes))
}

# The sample statistics and the plot read the tail of the log rather than all of it. The
# window is large enough to cover weeks of intervals, and the report says when it bites.
windowed=0
prepare() {
  local size
  advance_state

  size=$(stat -c %s "$log" 2>/dev/null || echo 0)
  if [ "$size" -gt "$window" ]; then
    windowed=1
    # tail -c lands mid-line, so drop the first one
    tail -c "$window" "$log" | tail -n +2 | grep 'timestamp=' > "$tmplog"
  else
    windowed=0
    grep 'timestamp=' "$log" > "$tmplog"
  fi

  # sort -n rather than -g: these are plain integers once the commas are gone, and the
  # general-numeric comparison is more than twice as slow for the same answer
  grep -o 'patternsPerSec=[0-9,]*' "$tmplog" | sed 's/.*=//' | tr -d ',' | sort -n > "$tmppps"
}

tmplog=$(mktemp) && tmppps=$(mktemp) && tmpchunk=$(mktemp) || exit 1
trap 'rm -f "$tmplog" "$tmppps" "$tmpchunk" "$tmpchunk.t"' EXIT

statefile=$(state_path) || statefile=""
if [ -n "$statefile" ]; then
  [ -n "$rescan" ] && rm -f "$statefile"
  load_state
fi

# ---------------------------------------------------------------- notifications --
#
# Three things are worth a mail: crossing the next whole percent, a new best, and a daily
# summary. Run this from a timer - `--notify` evaluates the triggers, sends what fired and
# exits - rather than from the watch loop, so a closed terminal does not stop the reports.
#
# What has already been announced lives beside the counter cache. Without it a timer firing
# every ten minutes would mail the same percentage 144 times a day.
notifyfile="$statefile.notify"
nfVersion=0; nfPct=-1; nfBest=0; nfDaily=0

load_notify() {
  [ -r "$notifyfile" ] || return 0
  # shellcheck disable=SC1090
  . "$notifyfile" 2>/dev/null || return 0
  [ "${nfVersion:-0}" = 1 ] || { nfPct=-1; nfBest=0; nfDaily=0; }
}

save_notify() {
  local tmp="$notifyfile.$$"
  printf 'nfVersion=1\nnfPct=%s\nnfBest=%s\nnfDaily=%s\n' \
         "$nfPct" "$nfBest" "$nfDaily" > "$tmp" && mv -f "$tmp" "$notifyfile"
}

# Handed to the local MTA, which is msmtp here relaying through Gmail on 587. Going out over
# SMTP submission rather than through an API is what makes this work at all: mail sent by
# Apps Script's MailApp never reached the sending account's own inbox, while the same
# account submitting the same message over SMTP lands normally.
#
# -t takes the recipient from the To: header, so this works with any sendmail-compatible
# MTA and the tool needs no transport configuration of its own.
send_mail() {
  local subject=$1 bodyfile=$2 htmlfile=$3 boundary out
  boundary="report-$(date +%s)-$$"

  # multipart/alternative: the HTML part is the readable one, because the report is a
  # monospace table and clients render text/plain in a proportional font. The plain part is
  # there for anything that asks for it, and for the preview line in a message list.
  out=$(
    {
      [ -n "${STATS_MAIL_FROM:-}" ] && printf 'From: %s\n' "$STATS_MAIL_FROM"
      printf 'To: %s\n' "$mailto"
      printf 'Subject: %s\n' "$subject"
      printf 'MIME-Version: 1.0\n'
      printf 'Content-Type: multipart/alternative; boundary="%s"\n\n' "$boundary"

      printf -- '--%s\nContent-Type: text/plain; charset=UTF-8\n\n' "$boundary"
      cat "$bodyfile"

      if [ -n "$htmlfile" ]; then
        printf -- '\n--%s\nContent-Type: text/html; charset=UTF-8\n\n' "$boundary"
        printf '<html><body style="margin:0">\n'
        cat "$htmlfile"
        printf '</body></html>\n'
      fi

      printf -- '\n--%s--\n' "$boundary"
    } | "${STATS_SENDMAIL:-sendmail}" -t 2>&1
  ) || {
    echo "send failed: ${out:-sendmail exited non-zero}" >&2
    return 1
  }
  [ -n "$out" ] && echo "$out" >&2
  return 0
}

# Colour codes are for a terminal, and the report is a monospace table: a mail needs the
# escapes turned into markup and the whole thing in a <pre>, or it arrives full of ESC[36m
# and re-wrapped in a proportional font. Mapped for a light background, since that is what
# mail clients default to.
ansi_to_html() {
  awk '
  function style(c) {
    if (c == "1")    return "font-weight:bold"
    if (c == "2")    return "color:#9aa0a6"
    if (c == "36")   return "color:#0b7285"
    if (c == "32")   return "color:#2b8a3e"
    if (c == "33")   return "color:#b8860b"
    if (c == "1;93") return "color:#b06f00;font-weight:bold"
    if (c == "1;92") return "color:#2b8a3e;font-weight:bold"
    return ""
  }
  BEGIN {
    printf "<pre style=\"font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;"
    printf "font-size:12px;line-height:1.3;white-space:pre\">"
  }
  {
    line = $0
    gsub(/&/, "\\&amp;", line); gsub(/</, "\\&lt;", line); gsub(/>/, "\\&gt;", line)
    out = ""; open = 0
    # The report never nests colours - every run is opened and closed before the next - so
    # one span at a time is enough
    while (match(line, /\033\[[0-9;]*m/)) {
      out = out substr(line, 1, RSTART - 1)
      code = substr(line, RSTART + 2, RLENGTH - 3)
      line = substr(line, RSTART + RLENGTH)
      if (open) { out = out "</span>"; open = 0 }
      if (style(code) != "") { out = out "<span style=\"" style(code) "\">"; open = 1 }
    }
    out = out line
    if (open) out = out "</span>"
    print out
  }
  END { print "</pre>" }'
}

# The mailed report covers a day rather than the last hundred intervals, which is the point
# of it: the screen already shows the recent window.
mail_report() {
  local subject=$1 coloured plain html rc
  coloured=$(mktemp) && plain=$(mktemp) && html=$(mktemp) || return 1

  # Rendered once with colour on whatever the terminal is doing, then split two ways
  (
    bold=$'\033[1m'; dim=$'\033[2m'; cyan=$'\033[36m'
    green=$'\033[32m'; yellow=$'\033[33m'; reset=$'\033[0m'
    hi=$'\033[1;93m'; found=$'\033[1;92m'
    forceRows=${STATS_MAIL_ROWS:-40}
    periodSec=${STATS_PERIOD:-86400}
    periodName=24h
    printf '%s\n%s\n\n' "$log" "$(date '+%a %d %b %Y %H:%M:%S %Z')"
    render "$tmplog" "$tmppps"
  ) > "$coloured"

  sed 's/\x1b\[[0-9;]*m//g' "$coloured" > "$plain"
  ansi_to_html < "$coloured" > "$html"

  send_mail "$subject" "$plain" "$html"
  rc=$?
  rm -f "$coloured" "$plain" "$html"
  return $rc
}

# Refuse early rather than at the first trigger, which might be days away
notify_preflight() {
  if [ -z "$mailto" ]; then
    echo "no recipient: pass --mailto ADDR" >&2
    return 2
  fi
  if ! command -v "${STATS_SENDMAIL:-sendmail}" >/dev/null 2>&1; then
    echo "no ${STATS_SENDMAIL:-sendmail} on PATH: install an MTA (msmtp-mta provides one)" >&2
    return 2
  fi
  return 0
}

# Evaluate the triggers and send whatever fired. Leaves a one-line summary in notifyStatus
# and says nothing itself, because in --watch this runs underneath a redrawing screen.
#
# The state file is shared with any other copy running against the same log - a watch
# session and a cron entry, say - so the whole check is taken under a lock. Without it both
# would read the same state, both would decide the same trigger had fired, and the mail
# would arrive twice.
notifyStatus=""
notify_check() {
  local lastline c m high pct best now dailyAt sent failed
  notifyStatus=""

  exec 9>"$notifyfile.lock" || return 1
  flock 9 || return 1
  load_notify

  # Position and best come from the last line and the counter cache, the same two sources
  # the report uses, so a mail can never disagree with the screen.
  lastline=$(tail -1 "$tmplog")
  c=$(expr "$lastline" : '.*centerIdx=\([0-9]*\)')
  m=$(expr "$lastline" : '.*middleIdx=\([0-9]*\)')
  high=$(expr "$lastline" : '.*highGenerations=\([0-9]*\)')
  pct=$(( (${c:-0} * middles + ${m:-0}) * 100 / (centers * middles) ))
  best=${high:-0}
  [ "${stBest:-0}" -gt "$best" ] && best=$stBest
  now=$(date +%s)
  dailyAt=$(date -d "today ${STATS_DAILY_HOUR:-9}:00" +%s 2>/dev/null) || dailyAt=$((now + 1))

  # A first run has nothing to compare against, so it records where things stand and stays
  # quiet. Announcing 10% and a 214 that were both reached long ago is not news.
  if [ "$nfVersion" != 1 ]; then
    nfPct=$pct; nfBest=$best; nfDaily=$now
    save_notify
    notifyStatus="armed at ${pct}% and best ${best}"
    if [ -z "$mailnow" ]; then
      exec 9>&-
      return 0
    fi
  fi

  # Each trigger records itself only once its mail is actually away. Marking it announced
  # on a failed send would drop the notification for good, and a new best is exactly the
  # one thing that must not go missing because the network was down for a minute.
  sent=0; failed=0
  if [ -n "$mailnow" ]; then
    if mail_report "find-optimal: report - ${pct}% searched, best ${best}"; then
      sent=$((sent + 1)); nfDaily=$now
    else failed=$((failed + 1)); fi
  else
    if [ "$best" -gt "$nfBest" ]; then
      if mail_report "find-optimal: NEW BEST ${best} generations (was ${nfBest})"; then
        sent=$((sent + 1)); nfBest=$best
      else failed=$((failed + 1)); fi
    fi
    if [ "$pct" -gt "$nfPct" ]; then
      if mail_report "find-optimal: ${pct}% searched"; then
        sent=$((sent + 1)); nfPct=$pct
      else failed=$((failed + 1)); fi
    fi
    # The summary goes out at a wall-clock hour, not every 24 hours from the last one, so
    # it does not drift an hour later each day. Firing on "we are past today's hour and the
    # last one predates it" also means a machine that was asleep at nine sends once when it
    # wakes, rather than once for every morning it missed.
    if [ "$now" -ge "$dailyAt" ] && [ "$nfDaily" -lt "$dailyAt" ]; then
      if mail_report "find-optimal: daily report - ${pct}% searched, best ${best}"; then
        sent=$((sent + 1)); nfDaily=$now
      else failed=$((failed + 1)); fi
    fi
  fi
  save_notify
  exec 9>&-

  [ "$sent" -gt 0 ] && notifyStatus="sent $sent"
  if [ "$failed" -gt 0 ]; then
    notifyStatus="${notifyStatus:+$notifyStatus, }failed $failed - still pending, will retry"
    return 1
  fi
  return 0
}

# --mail-now means one message, now. Left to the watch loop it would send on every tick.
[ -n "$mailnow" ] && interval=0

# One-shot: evaluate, report, exit. This is the form a cron entry or a timer wants.
if [ -n "$notify" ] && [ "$interval" -eq 0 ]; then
  notify_preflight || exit $?
  prepare
  notify_check
  rc=$?
  [ -n "$notifyStatus" ] && echo "$notifyStatus" || echo "nothing to send"
  exit $rc
fi

if [ "$interval" -eq 0 ]; then
  prepare
  render "$tmplog" "$tmppps"
  exit $?
fi

# Redraw in place: home the cursor and clear below it, so a shorter report cannot leave
# stale lines behind and the screen does not flash the way a full clear does.
trap 'printf "\033[?25h\n"; rm -f "$tmplog" "$tmppps" "$tmpchunk" "$tmpchunk.t"; exit 0' INT TERM
[ -n "$notify" ] && { notify_preflight || exit $?; }
printf '\033[?25l'
while true; do
  prepare
  out=$(render "$tmplog" "$tmppps")

  # Checked on every tick, which costs three integer comparisons unless something fired.
  # Whatever it did is reported in the header rather than printed, so it cannot scribble
  # over the redrawing report below it.
  if [ -n "$notify" ]; then
    notify_check
    [ -n "$notifyStatus" ] && lastNotify="$(date '+%H:%M')  $notifyStatus"
  fi

  printf '\033[H\033[J%severy %ss   %s   %s%s%s\n\n%s\n' \
    "$dim" "$interval" "$log" "$(date '+%a %d %b %H:%M:%S')" \
    "${lastNotify:+   mail: $lastNotify}" "$reset" "$out"
  sleep "$interval"
done
