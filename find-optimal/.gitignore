# Allow specific vscode settings for find-optimal
!.vscode/
!.vscode/settings.json
!.vscode/launch.json.template

# Don't allow commiting launch.json because it probably has secrets in it.
.vscode/launch.json

# Temp directory for a disk-based request queue (for persistent retry)
request-queue/
request-queue-*/

# Oracle-mode progress, written as the search runs (see include/oracle_progress.h).
# Local state, not an artifact: it records which intervals hold nothing at or above the
# target, which is machine- and target-specific. The Bloom filter next to it IS committed.
data/strip-completion-oracle.bin
data/*.bin.tmp

# Don't allow pushing the uncompressed data
data/7x7subgrid-cache.json
